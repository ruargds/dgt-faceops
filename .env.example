# ══════════════════════════════════════════════════════════════════
# DGT FaceOps — configuração
# Copie para .env e preencha. NUNCA commite o .env.
#
# Onde roda: VM Linux hospedada no Windows Server (Hyper-V), FORA do
# ambiente facial. Requisito de rede: essa VM precisa alcançar as 4 VMs
# do Azure na porta 22 (NSG liberando o IP de saída, VPN ou Bastion).
# ══════════════════════════════════════════════════════════════════

# ── Banco do próprio painel ───────────────────────────────────────
POSTGRES_USER=faceops
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=faceops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Segurança ─────────────────────────────────────────────────────
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Desta chave deriva o cofre Fernet que guarda as chaves SSH e senhas.
# TROCAR ESTA CHAVE TORNA TODAS AS CREDENCIAIS GUARDADAS ILEGÍVEIS.
SECRET_KEY=troque-esta-chave
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Primeiro admin, criado no boot inicial se o banco estiver vazio.
# Padrão de fábrica admin/admin123 conforme combinado — o painel exibe
# faixa de aviso enquanto esta senha nao for trocada.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ── FindFace Multi (padrões dos hosts alvo) ───────────────────────
# Sobrescrevível por host no cadastro
FFMULTI_DIR=/opt/findface-multi
FFMULTI_COMPOSE=/opt/findface-multi/docker-compose.yaml

# ── Backups ───────────────────────────────────────────────────────
# Diretório de trabalho NO HOST REMOTO onde o artefato é montado.
# ATENÇÃO: aponte para um disco com folga. Em servidor de FindFace o
# raiz costuma ser pequeno e o volume grande fica em outro ponto de
# montagem. Um perfil 'completo' precisa de ~60% do tamanho de data/
# livre aqui, e o script aborta antes de encher o disco de produção.
#   ex.: /media/STORAGE/faceops-staging
REMOTE_STAGING_DIR=/var/backups/faceops
# Diretório local do painel (destino "local"), DENTRO do container
LOCAL_BACKUP_DIR=/data/backups

# Onde esses caminhos ficam NO HOST. Preenchidos pelo instalar.sh.
# Ficam aqui, e não no docker-compose.yml, para o arquivo versionado
# permanecer intocado — senão o git pull da atualização falha.
DIR_BACKUPS=./data/backups
DIR_SESSOES=./data/sessions
DIR_MARCA=./data/marca
# Retenção padrão em dias, por perfil
RETENTION_CONFIG_DAYS=90
RETENTION_ESSENCIAL_DAYS=30
RETENTION_COMPLETO_DAYS=180

# ── Destinos de backup ────────────────────────────────────────────
# NÃO se configuram mais aqui. Destinos (local, Azure Blob e rclone —
# que cobre Drive, S3, B2, OneDrive, SFTP…) são cadastrados PELA WEB,
# na tela Destinos, com as credenciais cifradas no cofre.
#
# Na primeira subida o painel cria sozinho um destino local apontando
# para LOCAL_BACKUP_DIR, marcado como padrão.
#
# Ver docs/13_DESTINOS.md

# ── Terminal InTerminal ───────────────────────────────────────────
# Grava as sessões em disco para auditoria (asciicast v2)
TERMINAL_RECORD=true
TERMINAL_SESSION_DIR=/data/sessions
TERMINAL_IDLE_TIMEOUT_MIN=30

# ── Rede do painel ────────────────────────────────────────────────
# Porta em que o painel responde na VM.
#
# O HTTP só redireciona para o HTTPS — o acesso de verdade é pelo HTTPS.
# O TLS existe para usuário e senha não trafegarem em claro na rede
# interna; o certificado autoassinado é gerado pelo instalador.
PORTA_HTTP=8080
PORTA_HTTPS=8443

# ── Timezone ──────────────────────────────────────────────────────
TZ=America/Sao_Paulo
